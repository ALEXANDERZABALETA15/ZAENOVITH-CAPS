# Copiar a .env.local y completar. En el hosting se cargan las mismas variables.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudinary (Settings → API Keys). Solo servidor: firma las subidas del panel y borra fotos.
CLOUDINARY_CLOUD_NAME=dg4kazsno
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Refresco instantáneo de la tienda desde un webhook de Supabase (ver src/app/api/revalidar/route.js)
REVALIDAR_SECRETO=

# Analítica (opcional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
